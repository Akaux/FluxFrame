{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_FLUXFRAME_framegen",
    "type": "GLOBAL",
    "library_path": "@LIBPATH@",
    "api_version": "1.3.0",
    "implementation_version": "1",
    "description": "FluxFrame: geração de quadros como camada Vulkan",
